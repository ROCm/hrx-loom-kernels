// Private execution witnesses for the GGML Q6_K carrier motif.
//
// The wrapper kernels own full-record addressing, launch geometry, tail
// publication, and floating-point scale materialization. The public function
// remains a carrier-only accessor suitable for integer or floating-point
// consumers with independent schedules.
func.decl @ggml_q6_k_unpack_codes4(%low_word: vector<1xi32>, %high_word: vector<1xi32>, %low_nibble: index, %high_pair: index) -> (vector<4xi8>)

// Exposes all eight selector combinations over one pair of carrier words.
kernel.def @test_ggml_q6_k_unpack_selector_table() {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c8, %c1, %c1) : index
} launch(%low_input: buffer, %high_input: buffer, %output: buffer) {
  %selector = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %base = index.constant 0 : offset
  %low_nibble = index.rem %selector, %c2 : index
  %high_pair = index.div %selector, %c2 : index
  %low_view = buffer.view %low_input[%base] : buffer -> view<1xi32>
  %high_view = buffer.view %high_input[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<32xi8>
  %low_word = vector.load %low_view[%c0] : view<1xi32> -> vector<1xi32>
  %high_word = vector.load %high_view[%c0] : view<1xi32> -> vector<1xi32>
  %codes = func.call @ggml_q6_k_unpack_codes4(%low_word, %high_word, %low_nibble, %high_pair) : (vector<1xi32>, vector<1xi32>, index, index) -> (vector<4xi8>)
  %output_base = index.mul %selector, %c4 : index
  vector.store %codes, %output_view[%output_base] : vector<4xi8>, view<32xi8>
  kernel.return
}

// Decodes complete blocks and logical tails. One 64-lane workgroup owns every
// four-value packet in one 210-byte record.
kernel.def @test_ggml_q6_k_unpack_codes(%element_count: index) {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %padded_count = index.add %element_count, %c255 : index
  %block_count = index.div %padded_count, %c256 : index
  kernel.launch.config workgroups(%block_count, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%element_count: index, %input: buffer, %output: buffer) {
  %bounded_count = index.assume %element_count [range(%element_count, 1, 65536)] : index
  %block = kernel.workgroup.id<x> : index
  %packet = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %base = index.constant 0 : offset
  %half = index.div %packet, %c32 : index
  %packet_in_half = index.rem %packet, %c32 : index
  %high_pair = index.div %packet_in_half, %c8 : index
  %word = index.rem %packet_in_half, %c8 : index
  %low_side = index.rem %high_pair, %c2 : index
  %low_nibble = index.div %high_pair, %c2 : index
  %low_half_base = index.mul %half, %c16 : index
  %low_side_add = index.mul %low_side, %c8 : index
  %low_word0 = index.add %low_half_base, %low_side_add : index
  %low_word_index = index.add %low_word0, %word : index
  %high_half_base = index.mul %half, %c8 : index
  %high_word_index = index.add %high_half_base, %word : index
  %low_byte_index = index.mul %low_word_index, %c4 : index
  %high_word_byte_index = index.mul %high_word_index, %c4 : index
  %high_byte_index = index.add %c128, %high_word_byte_index : index
  %input_block_count0 = index.add %bounded_count, %c255 : index
  %input_block_count = index.div %input_block_count0, %c256 : index
  %bounded_input_block_count = index.assume %input_block_count [range(%input_block_count, 1, 256)] : index
  %block_in_bounds = index.cmp ult, %block, %bounded_input_block_count : index
  scf.if %block_in_bounds {
    %bounded_block = index.assume %block [range(%block, 0, 255), lt(%block, %bounded_input_block_count)] : index
    %input_view = buffer.view %input[%base] : buffer -> view<[%bounded_input_block_count]x210xi8>
    %output_view = buffer.view %output[%base] : buffer -> view<[%bounded_count]xi8>
    %low_bytes = vector.load %input_view[%bounded_block, %low_byte_index] : view<[%bounded_input_block_count]x210xi8> -> vector<4xi8>
    %high_bytes = vector.load %input_view[%bounded_block, %high_byte_index] : view<[%bounded_input_block_count]x210xi8> -> vector<4xi8>
    %low_word = vector.bitcast %low_bytes : vector<4xi8> to vector<1xi32>
    %high_word = vector.bitcast %high_bytes : vector<4xi8> to vector<1xi32>
    %codes = func.call @ggml_q6_k_unpack_codes4(%low_word, %high_word, %low_nibble, %high_pair) : (vector<1xi32>, vector<1xi32>, index, index) -> (vector<4xi8>)
    %block_output_base = index.mul %bounded_block, %c256 : index
    %packet_output_add = index.mul %packet, %c4 : index
    %output_base = index.add %block_output_base, %packet_output_add : index
    %output_end = index.add %output_base, %c4 : index
    %is_full_packet = index.cmp ule, %output_end, %bounded_count : index
    scf.if %is_full_packet {
      vector.store %codes, %output_view[%output_base] : vector<4xi8>, view<[%bounded_count]xi8>
    } else {
      scf.for %element = [%c0 to %c4 step %c1] unroll {
        %output_index = index.add %output_base, %element : index
        %is_valid = index.cmp ult, %output_index, %bounded_count : index
        scf.if %is_valid {
          %value = vector.extract %codes[%element] : vector<4xi8> -> i8
          view.store %value, %output_view[%output_index] : i8, view<[%bounded_count]xi8>
        }
      }
    }
  }
  kernel.return
}

// Applies one signed group scale and F16 block scale after carrier decoding.
kernel.def @test_ggml_q6_k_signed_scale() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%low_input: buffer, %high_input: buffer, %scale_input: buffer, %block_scale_input: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %base = index.constant 0 : offset
  %low_view = buffer.view %low_input[%base] : buffer -> view<1xi32>
  %high_view = buffer.view %high_input[%base] : buffer -> view<1xi32>
  %scale_view = buffer.view %scale_input[%base] : buffer -> view<1xi8>
  %block_scale_view = buffer.view %block_scale_input[%base] : buffer -> view<1xf16>
  %output_view = buffer.view %output[%base] : buffer -> view<4xf32>
  %low_word = vector.load %low_view[%c0] : view<1xi32> -> vector<1xi32>
  %high_word = vector.load %high_view[%c0] : view<1xi32> -> vector<1xi32>
  %codes = func.call @ggml_q6_k_unpack_codes4(%low_word, %high_word, %c0, %c0) : (vector<1xi32>, vector<1xi32>, index, index) -> (vector<4xi8>)
  %scale_i8 = view.load %scale_view[%c0] : view<1xi8> -> i8
  %block_scale_f16 = view.load %block_scale_view[%c0] : view<1xf16> -> f16
  %codes_f32 = vector.sitofp %codes : vector<4xi8> to vector<4xf32>
  %scale = scalar.sitofp %scale_i8 : i8 to f32
  %block_scale = scalar.extf %block_scale_f16 : f16 to f32
  %combined_scale = scalar.mulf %scale, %block_scale : f32
  %combined_scale_vector = vector.splat %combined_scale : vector<4xf32>
  %values = vector.mulf %codes_f32, %combined_scale_vector : vector<4xf32>
  vector.store %values, %output_view[%c0] : vector<4xf32>, view<4xf32>
  kernel.return
}

check.case public @ggml_q6_k_selector_layout_case {
  %low_input = check.generate.iota offset(16) step(34) : tensor<4xi8>
  %high_input = check.generate.fill value(-28) : tensor<4xi8>
  %output = check.generate.fill value(-1) : tensor<32xi8>
  %output0 = check.tensor.view %output offset(0) : tensor<32xi8> -> tensor<4xi8>
  %output1 = check.tensor.view %output offset(4) : tensor<32xi8> -> tensor<4xi8>
  %output2 = check.tensor.view %output offset(8) : tensor<32xi8> -> tensor<4xi8>
  %output3 = check.tensor.view %output offset(12) : tensor<32xi8> -> tensor<4xi8>
  %output4 = check.tensor.view %output offset(16) : tensor<32xi8> -> tensor<4xi8>
  %output5 = check.tensor.view %output offset(20) : tensor<32xi8> -> tensor<4xi8>
  %output6 = check.tensor.view %output offset(24) : tensor<32xi8> -> tensor<4xi8>
  %output7 = check.tensor.view %output offset(28) : tensor<32xi8> -> tensor<4xi8>
  %expected0 = check.generate.iota offset(-32) step(2) : tensor<4xi8>
  %expected1 = check.generate.iota offset(-31) step(2) : tensor<4xi8>
  %expected2 = check.generate.iota offset(-16) step(2) : tensor<4xi8>
  %expected3 = check.generate.iota offset(-15) step(2) : tensor<4xi8>
  %expected4 = check.generate.iota offset(0) step(2) : tensor<4xi8>
  %expected5 = check.generate.iota offset(1) step(2) : tensor<4xi8>
  %expected6 = check.generate.iota offset(16) step(2) : tensor<4xi8>
  %expected7 = check.generate.iota offset(17) step(2) : tensor<4xi8>
  kernel.launch @test_ggml_q6_k_unpack_selector_table(%low_input, %high_input, %output) : (tensor<4xi8>, tensor<4xi8>, tensor<32xi8>)
  check.expect.equal actual(%output0) expected(%expected0) : tensor<4xi8>
  check.expect.equal actual(%output1) expected(%expected1) : tensor<4xi8>
  check.expect.equal actual(%output2) expected(%expected2) : tensor<4xi8>
  check.expect.equal actual(%output3) expected(%expected3) : tensor<4xi8>
  check.expect.equal actual(%output4) expected(%expected4) : tensor<4xi8>
  check.expect.equal actual(%output5) expected(%expected5) : tensor<4xi8>
  check.expect.equal actual(%output6) expected(%expected6) : tensor<4xi8>
  check.expect.equal actual(%output7) expected(%expected7) : tensor<4xi8>
  check.return
}

check.case public @ggml_q6_k_code_extrema_case {
  %element_count = check.literal value(256) : index
  %low_input = check.generate.fill value(0) : tensor<210xi8>
  %high_input = check.generate.fill value(-1) : tensor<210xi8>
  %low_output = check.generate.fill value(0) : tensor<256xi8>
  %high_output = check.generate.fill value(0) : tensor<256xi8>
  %expected_low = check.generate.fill value(-32) : tensor<256xi8>
  %expected_high = check.generate.fill value(31) : tensor<256xi8>
  kernel.launch @test_ggml_q6_k_unpack_codes[%element_count](%element_count, %low_input, %low_output) : [index](index, tensor<210xi8>, tensor<256xi8>)
  kernel.launch @test_ggml_q6_k_unpack_codes[%element_count](%element_count, %high_input, %high_output) : [index](index, tensor<210xi8>, tensor<256xi8>)
  check.expect.equal actual(%low_output) expected(%expected_low) : tensor<256xi8>
  check.expect.equal actual(%high_output) expected(%expected_high) : tensor<256xi8>
  check.return
}

check.case public @ggml_q6_k_tail_case {
  %element_count = check.literal value(243) : index
  %input = check.generate.fill value(0) : tensor<210xi8>
  %output = check.generate.fill value(0) : tensor<243xi8>
  %expected = check.generate.fill value(-32) : tensor<243xi8>
  kernel.launch @test_ggml_q6_k_unpack_codes[%element_count](%element_count, %input, %output) : [index](index, tensor<210xi8>, tensor<243xi8>)
  check.expect.equal actual(%output) expected(%expected) : tensor<243xi8>
  check.return
}

check.case public @ggml_q6_k_signed_scale_case {
  %low_input = check.generate.fill value(0) : tensor<1xi32>
  %high_input = check.generate.fill value(0) : tensor<1xi32>
  %scale_input = check.generate.fill value(-3) : tensor<1xi8>
  %block_scale_input = check.generate.fill value(0.5) : tensor<1xf16>
  %output = check.generate.fill value(0.0) : tensor<4xf32>
  %expected = check.generate.fill value(48.0) : tensor<4xf32>
  kernel.launch @test_ggml_q6_k_signed_scale(%low_input, %high_input, %scale_input, %block_scale_input, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<1xi8>, tensor<1xf16>, tensor<4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.return
}

check.case public @ggml_q6_k_codes_benchmark_case {
  %element_count = check.literal value(65536) : index
  %input = check.generate.fill value(0) : tensor<53760xi8>
  %output = check.generate.fill value(0) : tensor<65536xi8>
  %expected = check.generate.fill value(-32) : tensor<65536xi8>
  kernel.launch @test_ggml_q6_k_unpack_codes[%element_count](%element_count, %input, %output) : [index](index, tensor<53760xi8>, tensor<65536xi8>)
  check.expect.equal actual(%output) expected(%expected) : tensor<65536xi8>
  check.return
}

check.benchmark<@ggml_q6_k_codes_benchmark_case> @ggml_q6_k_unpack_codes_benchmark
